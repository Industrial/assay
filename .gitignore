# Rust / cargo
/target/
**/*.rs.bk
*.profraw
lcov.info
*.info
# Registry tokens; .cargo/config.toml and .cargo/audit.toml are tracked.
.cargo/credentials
.cargo/credentials.toml

# Dev environment (devenv, direnv, moon, agent tool state)
.devenv*
.direnv
devenv.local.nix
.moon/cache/
/.roam/
/.serena/
node_modules/

# Secrets
.env
.env.local
.env.*.local

# Scratch, logs, local data
/.tmp
/tmp/
/data/
log/*
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.idea/
.vscode/
*.sw?
.DS_Store
Thumbs.db

# Local databases (Nix store fixture DBs are tracked)
*.db
*.sqlite
!crates/**/fixtures/**/*.sqlite

# Maestro runtime state
.maestro/missions/*
!.maestro/missions/*.md
!.maestro/missions/.gitkeep
.maestro/sessions/
.maestro/tasks/local-history/
.maestro/evidence/
.maestro/runs/
